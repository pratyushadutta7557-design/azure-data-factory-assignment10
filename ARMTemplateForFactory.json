                "typeProperties": {
                    "location": {
                        "type": "AzureBlobFSLocation",
                        "fileName": "hotels.csv",
                        "folderPath": "raw",
                        "fileSystem": "staynest"
                    },
                    "columnDelimiter": ",",
                    "escapeChar": "\\",
                    "firstRowAsHeader": true,
                    "quoteChar": "\""
                },
                "schema": [
                    {
                        "name": "hotel_id",
                        "type": "String"
                    },
                    {
                        "name": "hotel_name",
                        "type": "String"
                    },
                    {
                        "name": "city",
                        "type": "String"
                    },
                    {
