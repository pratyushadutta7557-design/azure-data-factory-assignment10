            "type": "secureString",
            "metadata": "Secure string for 'accountKey' of 'ADLS_Assignment_10'"
        },
        "ADLS_Assignment_10_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://sapratyushadutta.dfs.core.windows.net/"
